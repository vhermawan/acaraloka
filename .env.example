# Salin file ini ke .env.local dan isi nilainya. Jangan commit .env.local.
# Skema & validasi ada di src/lib/env.ts.

# Base URL publik aplikasi. Dipakai untuk tautan & QR (bukan dari header request).
# Default saat dev: http://localhost:3000
APP_BASE_URL=

# Connection string Prisma ke Supabase Postgres (dipasang di T-005 / A6).
DATABASE_URL=

# Header rahasia endpoint cron: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Konfigurasi Supabase (dipasang di T-004). URL & anon key aman untuk browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
