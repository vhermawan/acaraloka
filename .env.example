# Salin file ini ke .env.local dan isi nilainya. Jangan commit .env.local.
# Skema & validasi ada di src/lib/env.ts.

# Base URL publik aplikasi, untuk tautan & QR sertifikat permanen. Dev/test
# boleh kosong (default http://localhost:3000). Production wajib https,
# kalau kosong build/start akan gagal dengan error yang jelas (fail-loud).
# Vercel Preview boleh kosong, fallback ke https://$VERCEL_URL.
APP_BASE_URL=

# Prisma, transaction pooler Supabase (port 6543 + ?pgbouncer=true). Dipakai runtime.
DATABASE_URL=

# Prisma, session pooler Supabase (port 5432). Dipakai `prisma migrate`.
DIRECT_URL=

# Base URL project Supabase, untuk Storage server-side.
SUPABASE_URL=

# Service role key Supabase (melewati RLS). Server-side saja, jangan pernah
# diberi prefix NEXT_PUBLIC_ atau dikirim ke client.
SUPABASE_SERVICE_ROLE_KEY=

# Secret sesi Better Auth, acak >= 32 karakter (mis. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# Google OAuth client (Web application). Redirect URI: <APP_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Header rahasia endpoint cron: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Email admin platform. Dipakai skrip seed untuk membuat akun admin; kalau
# kosong, seed melewatkan pembuatan admin dengan pesan jelas.
ADMIN_EMAIL=

# Token beacon Cloudflare Web Analytics. Kosong = analytics tidak dipasang.
CLOUDFLARE_ANALYTICS_TOKEN=

# Kunci Google Places API (server-side), untuk pencarian lokasi offline/hybrid.
# Kosong = pencarian lokasi nonaktif, panitia mengetik alamat manual.
GOOGLE_PLACES_API_KEY=

# Kunci Maps Embed API (browser), untuk mini map di halaman acara. Batasi ke
# HTTP referrer domain aplikasi di Google Cloud Console. Kosong = map disembunyikan.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Email transaksional lewat Resend. EMAIL_ENABLED=false = email tidak dikirim.
EMAIL_ENABLED=false
# Pengirim, mis. "Acaraloka <noreply@domain-terverifikasi>".
EMAIL_FROM=
EMAIL_REPLY_TO=
# Batas email per hari (1-100, default 95; kuota gratis Resend 100/hari).
EMAIL_DAILY_BUDGET=95

# AI desain sertifikat. AI_ENABLED=true butuh GOOGLE_VERTEX_PROJECT dan
# GOOGLE_VERTEX_SA_KEY_B64; akses panitia tetap lewat allowlist (`pnpm ai:allow <email>`).
AI_ENABLED=false
# Cap biaya bulanan (US$). Sebelum AI_TRIAL_ENDS_ON (YYYY-MM-DD) dipakai AI_TRIAL_CAP_USD.
AI_MONTHLY_CAP_USD=10
AI_TRIAL_CAP_USD=30
AI_TRIAL_ENDS_ON=
# Batas waktu satu generate (10000-110000 ms) dan batas generate global per hari.
AI_GENERATION_DEADLINE_MS=60000
AI_GLOBAL_DAILY_LIMIT=40
# Penyedia gambar & teks. Saat ini hanya "vertex".
AI_IMAGE_PROVIDER=vertex
AI_TEXT_PROVIDER=vertex

# Vertex AI (Agent Platform). SA key JSON di-encode base64 satu baris
# (`base64 -i key.json | tr -d '\n'`). Server-side saja, jangan commit file JSON-nya.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
GOOGLE_VERTEX_SA_KEY_B64=
VERTEX_IMAGE_MODEL=gemini-nano-banana-2.1
VERTEX_TEXT_MODEL=gemini-3.1-flash-lite
