# Salin file ini ke .env.local dan isi nilainya. Jangan commit .env.local.
# Skema & validasi ada di src/lib/env.ts.

# Base URL publik aplikasi. Dipakai untuk tautan & QR sertifikat permanen
# (bukan dari header request), jadi salah isi berarti QR yang sudah tercetak
# bisa mengarah ke alamat yang salah.
# - Dev/test: boleh kosong, default http://localhost:3000.
# - Production (NODE_ENV=production — termasuk `npm run build`/`next start`
#   lokal, bukan cuma deploy Vercel): WAJIB diisi dengan URL https, kalau
#   kosong proses akan gagal dengan error yang jelas (disengaja, fail-loud).
#   Isi APP_BASE_URL=http://localhost:3000 kalau cuma ingin build lokal.
# - Vercel Preview (VERCEL_ENV=preview): boleh dikosongkan, otomatis
#   fallback ke https://$VERCEL_URL bawaan Vercel.
APP_BASE_URL=

# Prisma ke Supabase Postgres (dipasang di T-005).
# DATABASE_URL: transaction pooler (port 6543) + ?pgbouncer=true, dipakai runtime.
# DIRECT_URL: session pooler (port 5432), dipakai migrasi. Jangan pakai
# direct connection db.*.supabase.co (IPv6-only di free tier).
DATABASE_URL=
DIRECT_URL=

# Supabase Storage, server-side saja (dipasang di T-011). Service role key
# melewati RLS: jangan pernah diberi prefix NEXT_PUBLIC_ atau dikirim ke client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth (dipasang di T-004). Base URL auth memakai APP_BASE_URL.
# BETTER_AUTH_SECRET: acak >= 32 karakter, mis. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Google OAuth client (Web application). Redirect URI yang didaftarkan:
# <APP_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Header rahasia endpoint cron: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
